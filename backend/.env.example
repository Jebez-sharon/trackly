# Copy this to backend/.env and fill in the values.
# .env is gitignored and must never be committed.

# Postgres connection string.
# Supabase: Project Settings > Database > Connection string > URI.
# A postgres:// prefix is normalised to postgresql:// at startup, so either works.
DATABASE_URL=

# Signs and verifies JWTs. Any long random string; 64 bytes of hex is plenty:
#   python -c "import secrets; print(secrets.token_hex(64))"
# Changing this invalidates every session that is currently signed in.
JWT_SECRET_KEY=

